# Every secret the project needs, with no values. Copy to .env and fill in.
# How to get each one is in docs/SETUP.md.

# Anthropic API key - console.anthropic.com > API Keys. Without it the app runs the
# built-in offline story only.
ANTHROPIC_API_KEY=

# Optional, not secret: model and effort (defaults: claude-opus-5-5, low)
CLAUDE_MODEL=
CLAUDE_EFFORT=
